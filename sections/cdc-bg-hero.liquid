{% liquid
  assign desktop_image = section.settings.desktop_image
  assign tablet_image = section.settings.tablet_image
  assign mobile_image = section.settings.mobile_image

  if desktop_image == blank
    if tablet_image != blank
      assign desktop_image = tablet_image
    elsif mobile_image != blank
      assign desktop_image = mobile_image
    endif
  endif

  if tablet_image == blank
    assign tablet_image = desktop_image
  endif

  if mobile_image == blank
    if tablet_image != blank
      assign mobile_image = tablet_image
    else
      assign mobile_image = desktop_image
    endif
  endif

  assign top_line_font = section.settings.top_line_font
  assign heading_font = section.settings.heading_font
  assign subheading_font = section.settings.subheading_font
%}

{{ 'cdc-bg-hero.css' | asset_url | stylesheet_tag }}

{% style %}
  {{ top_line_font | font_face: font_display: 'swap' }}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ subheading_font | font_face: font_display: 'swap' }}

  #CdcBgHero-{{ section.id }} {
    --cdc-bg-hero-section-height-desktop: {{ section.settings.section_height_desktop }}px;

    --cdc-bg-hero-page-width: {{ section.settings.page_width }}px;
    --cdc-bg-hero-background-color: {{ section.settings.section_background_color }};
    --cdc-bg-hero-image-opacity: {{ section.settings.image_opacity | divided_by: 100.0 }};
    --cdc-bg-hero-side-padding-desktop: {{ section.settings.side_padding_desktop }}px;
    --cdc-bg-hero-side-padding-tablet: {{ section.settings.side_padding_tablet }}px;
    --cdc-bg-hero-side-padding-mobile: {{ section.settings.side_padding_mobile }}px;
    --cdc-bg-hero-bottom-radius-desktop: {{ section.settings.bottom_radius_desktop }}px;
    --cdc-bg-hero-bottom-radius-tablet: {{ section.settings.bottom_radius_tablet }}px;
    --cdc-bg-hero-bottom-radius-mobile: {{ section.settings.bottom_radius_mobile }}px;

    --cdc-bg-hero-content-max-width: {{ section.settings.content_max_width }}px;
    --cdc-bg-hero-content-margin-top-desktop: {{ section.settings.content_margin_top_desktop }}px;
    --cdc-bg-hero-content-margin-top-tablet: {{ section.settings.content_margin_top_tablet }}px;
    --cdc-bg-hero-content-margin-top-mobile: {{ section.settings.content_margin_top_mobile }}px;

    --cdc-bg-hero-content-padding-desktop: {{ section.settings.content_padding_desktop }}px;
    --cdc-bg-hero-content-padding-tablet: {{ section.settings.content_padding_tablet }}px;
    --cdc-bg-hero-content-padding-mobile: {{ section.settings.content_padding_mobile }}px;

    --cdc-bg-hero-top-line-color: {{ section.settings.top_line_color }};
    --cdc-bg-hero-top-line-size-desktop: {{ section.settings.top_line_size_desktop }}px;
    --cdc-bg-hero-top-line-size-tablet: {{ section.settings.top_line_size_tablet }}px;
    --cdc-bg-hero-top-line-size-mobile: {{ section.settings.top_line_size_mobile }}px;
    --cdc-bg-hero-top-line-line-height-desktop: {{ section.settings.top_line_line_height_desktop | divided_by: 100.0 }};
    --cdc-bg-hero-top-line-line-height-tablet: {{ section.settings.top_line_line_height_tablet | divided_by: 100.0 }};
    --cdc-bg-hero-top-line-line-height-mobile: {{ section.settings.top_line_line_height_mobile | divided_by: 100.0 }};
    --cdc-bg-hero-top-line-margin-bottom: {{ section.settings.top_line_margin_bottom }}px;
    --cdc-bg-hero-top-line-font-family: {{ top_line_font.family | json }}, {{ top_line_font.fallback_families }};
    --cdc-bg-hero-top-line-font-style: {{ top_line_font.style }};
    --cdc-bg-hero-top-line-font-weight: {{ section.settings.top_line_font_weight }};
    --cdc-bg-hero-top-line-text-transform: {% if section.settings.top_line_uppercase %}uppercase{% else %}none{% endif %};

    --cdc-bg-hero-heading-color: {{ section.settings.heading_color }};
    --cdc-bg-hero-heading-max-width-desktop: {{ section.settings.heading_max_width_desktop }}px;
    --cdc-bg-hero-heading-max-width-tablet: {{ section.settings.heading_max_width_tablet }}px;
    --cdc-bg-hero-heading-max-width-mobile: {{ section.settings.heading_max_width_mobile }}px;
    --cdc-bg-hero-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --cdc-bg-hero-heading-size-tablet: {{ section.settings.heading_size_tablet }}px;
    --cdc-bg-hero-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --cdc-bg-hero-heading-line-height-desktop: {{ section.settings.heading_line_height_desktop | divided_by: 100.0 }};
    --cdc-bg-hero-heading-line-height-tablet: {{ section.settings.heading_line_height_tablet | divided_by: 100.0 }};
    --cdc-bg-hero-heading-line-height-mobile: {{ section.settings.heading_line_height_mobile | divided_by: 100.0 }};
    --cdc-bg-hero-heading-font-family: {{ heading_font.family | json }}, {{ heading_font.fallback_families }};
    --cdc-bg-hero-heading-font-style: {{ heading_font.style }};
    --cdc-bg-hero-heading-font-weight: {{ section.settings.heading_font_weight }};
    --cdc-bg-hero-heading-text-transform: {% if section.settings.heading_uppercase %}uppercase{% else %}none{% endif %};

    --cdc-bg-hero-subheading-color: {{ section.settings.subheading_color }};
    --cdc-bg-hero-subheading-size-desktop: {{ section.settings.subheading_size_desktop }}px;
    --cdc-bg-hero-subheading-size-tablet: {{ section.settings.subheading_size_tablet }}px;
    --cdc-bg-hero-subheading-size-mobile: {{ section.settings.subheading_size_mobile }}px;
    --cdc-bg-hero-subheading-line-height-desktop: {{ section.settings.subheading_line_height_desktop | divided_by: 100.0 }};
    --cdc-bg-hero-subheading-line-height-tablet: {{ section.settings.subheading_line_height_tablet | divided_by: 100.0 }};
    --cdc-bg-hero-subheading-line-height-mobile: {{ section.settings.subheading_line_height_mobile | divided_by: 100.0 }};
    --cdc-bg-hero-subheading-margin-top: {{ section.settings.subheading_margin_top }}px;
    --cdc-bg-hero-subheading-font-family: {{ subheading_font.family | json }}, {{ subheading_font.fallback_families }};
    --cdc-bg-hero-subheading-font-style: {{ subheading_font.style }};
    --cdc-bg-hero-subheading-font-weight: {{ section.settings.subheading_font_weight }};
    --cdc-bg-hero-subheading-text-transform: {% if section.settings.subheading_uppercase %}uppercase{% else %}none{% endif %};

    --cdc-bg-hero-buttons-margin-top-desktop: {{ section.settings.buttons_margin_top_desktop }}px;
    --cdc-bg-hero-buttons-margin-top-tablet: {{ section.settings.buttons_margin_top_tablet }}px;
    --cdc-bg-hero-buttons-margin-top-mobile: {{ section.settings.buttons_margin_top_mobile }}px;
    --cdc-bg-hero-buttons-gap-desktop: {{ section.settings.button_gap_desktop }}px;
    --cdc-bg-hero-buttons-gap-tablet: {{ section.settings.button_gap_tablet }}px;
    --cdc-bg-hero-buttons-gap-mobile: {{ section.settings.button_gap_mobile }}px;
    --cdc-bg-hero-buttons-layout-desktop: {{ section.settings.buttons_layout_desktop }};
  }

  #shopify-section-{{ section.id }} {
    position: relative;
    z-index: 2;
    background: {{ section.settings.section_background_color }};
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    #shopify-section-{{ section.id }},
    #CdcBgHero-{{ section.id }} {
      min-height: 100vh;
      min-height: 100svh;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }},
    #CdcBgHero-{{ section.id }} {
      min-height: 100vh;
      min-height: 100svh;
    }
  }
{% endstyle %}

<section
  id="CdcBgHero-{{ section.id }}"
  class="
    cdc-bg-hero
    cdc-bg-hero--desktop-{{ section.settings.text_alignment_desktop }}
    cdc-bg-hero--tablet-{{ section.settings.text_alignment_tablet }}
    cdc-bg-hero--mobile-{{ section.settings.text_alignment_mobile }}
  "
>
  <div class="cdc-bg-hero__surface">
    <div class="cdc-bg-hero__media">
        {% if desktop_image != blank %}
          <picture>
            {% if mobile_image != blank %}
              <source
                media="(max-width: 749px)"
                srcset="{{ mobile_image | image_url: width: 1200 }}"
              >
            {% endif %}

            {% if tablet_image != blank %}
              <source
                media="(max-width: 989px)"
                srcset="{{ tablet_image | image_url: width: 1800 }}"
              >
            {% endif %}

            <img
              src="{{ desktop_image | image_url: width: 2400 }}"
              alt="{{ section.settings.image_alt | escape }}"
              width="{{ desktop_image.width }}"
              height="{{ desktop_image.height }}"
              loading="{{ section.settings.image_loading }}"
              decoding="async"
              class="cdc-bg-hero__image"
            >
          </picture>
        {% else %}
          <div class="cdc-bg-hero__placeholder"></div>
        {% endif %}
    </div>

    <div class="cdc-bg-hero__inner">
      <div class="cdc-bg-hero__content">
        {% if section.settings.top_line != blank %}
          <div class="cdc-bg-hero__top-line">
            {{ section.settings.top_line }}
          </div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="cdc-bg-hero__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <div class="cdc-bg-hero__subheading">
            {{ section.settings.subheading }}
          </div>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="cdc-bg-hero__buttons">
            {% for block in section.blocks %}
              {% if block.settings.label != blank %}
                {% liquid
                  assign button_motion_class = ''

                  if block.settings.enable_zoom_out_on_hover
                    assign button_motion_class = ' cdc-bg-hero__button--zoom-out'
                  elsif block.settings.enable_zoom_in_on_hover
                    assign button_motion_class = ' cdc-bg-hero__button--zoom-in'
                  endif

                  if block.settings.enable_wave_animation
                    assign button_motion_class = button_motion_class | append: ' cdc-bg-hero__button--wave'
                  endif
                %}
                <a
                  href="{{ block.settings.link | default: '#' }}"
                  class="cdc-bg-hero__button cdc-bg-hero__button--{{ block.settings.button_style }}{{ button_motion_class }}"
                  style="
                  --cdc-bg-hero-button-bg: {{ block.settings.background_color }};
                  --cdc-bg-hero-button-bg-opacity: {{ block.settings.background_opacity }};
                  --cdc-bg-hero-button-color: {{ block.settings.text_color }};
                  --cdc-bg-hero-button-border: {{ block.settings.border_color }};
                  --cdc-bg-hero-button-backdrop-blur: {{ block.settings.backdrop_blur }}px;
                  --cdc-bg-hero-button-font-size: {{ block.settings.font_size }}px;
                    --cdc-bg-hero-button-font-weight: {{ block.settings.font_weight }};
                    --cdc-bg-hero-button-text-transform: {% if block.settings.uppercase %}uppercase{% else %}none{% endif %};
                    --cdc-bg-hero-button-radius: {{ block.settings.border_radius }}px;
                    --cdc-bg-hero-button-wave-speed: {{ block.settings.wave_speed_fill_in | divided_by: 1000.0 }}s;
                    --cdc-bg-hero-button-wave-color: {{ block.settings.wave_fill_color }};
                    --cdc-bg-hero-button-wave-start-color: {{ block.settings.wave_start_color }};
                    --cdc-bg-hero-button-wave-text-color: {{ block.settings.wave_text_color }};
                    --cdc-bg-hero-button-wave-border-color: {{ block.settings.wave_border_color }};
                  "
                  {{ block.shopify_attributes }}
                >
                  <span class="cdc-bg-hero__button-label">{{ block.settings.label }}</span>
                </a>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
